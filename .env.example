# Token of the customer-facing shop bot (from @BotFather)
SHOP_BOT_TOKEN=123456:AA...

# Token of the admin bot (from @BotFather) — a SEPARATE bot from the shop one
ADMIN_BOT_TOKEN=987654:BB...

# Comma-separated Telegram numeric user IDs allowed to use the admin bot.
# Find your own id by messaging @userinfobot
ADMIN_IDS=7760326635,1727558676

# Any random hard-to-guess string. Used to protect the webhook URLs.
WEBHOOK_SECRET=change-this-to-something-random

# Public HTTPS URL of this deployed server, e.g. https://my-shop.onrender.com
# Leave empty for local dev; Render sets RENDER_EXTERNAL_URL for you automatically.
PUBLIC_URL=

PORT=3000
